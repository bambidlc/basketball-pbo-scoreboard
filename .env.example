# ============================================================================
# Local development (.env) — copy this file to .env and fill in real values.
# In production (Render), set these in the dashboard instead of committing them.
# ============================================================================

# ---- Client build-time config (compiled into the browser bundle) ----
# Same-origin proxy path. The dev server (vite.config.ts) and the production
# server (server.js) both forward this prefix to Odoo, so keep it as /odoo.
VITE_ODOO_PROXY_PATH=/odoo
VITE_ODOO_API_MODE=json2
VITE_ODOO_DB=your_database
VITE_MATCH_POLL_MS=15000
VITE_LIVE_GAME_ID=

# In production the API key is injected by the server-side proxy, so the value
# shipped to the browser can be a non-secret placeholder. For LOCAL dev the
# Vite proxy does not inject a key, so use your real key here locally.
VITE_ODOO_API_KEY=your_api_key

# Used by the Vite dev proxy (local only) to know where to forward /odoo.
VITE_ODOO_URL=https://your-odoo-instance.odoo.com
# Username is only required for legacy (jsonrpc) mode.
VITE_ODOO_USERNAME=scorekeeper@example.com

# ---- Server-side secrets (used by server.js in production) ----
# These stay on the server and are NEVER exposed to the browser. On Render,
# set ODOO_URL and ODOO_API_KEY as secret env vars in the dashboard.
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_API_KEY=your_api_key
ODOO_DB=your_database
